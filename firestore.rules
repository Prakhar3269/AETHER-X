rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStringList(lst, maxLen) {
      return lst is list && lst.size() <= maxLen && (lst.size() == 0 || lst[0] is string);
    }

    function isNonEmptyMemberList(lst, maxLen) {
      return lst is list && lst.size() >= 1 && lst.size() <= maxLen && lst[0] is string;
    }

    function hasMemberAccess(data) {
      return data.ownerId == request.auth.uid || (request.auth.uid in data.memberUids);
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 60)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWorld(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isNonEmptyMemberList(data.memberUids, 50) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 9 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (!('connectedWorldIds' in data) || isStringList(data.connectedWorldIds, 20)) &&
             (!('orbitRadius' in data) || (data.orbitRadius is number && data.orbitRadius > 0 && data.orbitRadius <= 500)) &&
             (!('orbitAngle' in data) || (data.orbitAngle is number && data.orbitAngle >= -100 && data.orbitAngle <= 100)) &&
             (!('planetScale' in data) || (data.planetScale is number && data.planetScale >= 0.4 && data.planetScale <= 3.0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProject(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isNonEmptyMemberList(data.memberUids, 50) &&
             data.worldId is string && isValidId(data.worldId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 600)) &&
             data.status is string && data.status in ['planning', 'active', 'completed', 'archived'] &&
             data.progress is int && data.progress >= 0 && data.progress <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTaskItem(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isNonEmptyMemberList(data.memberUids, 50) &&
             data.worldId is string && isValidId(data.worldId) &&
             (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128)) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.status is string && data.status in ['todo', 'in_progress', 'done'] &&
             data.priority is string && data.priority in ['low', 'medium', 'high', 'critical'] &&
             (!('assignedAgent' in data) || (data.assignedAgent is string && data.assignedAgent.size() <= 40)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTeam(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isNonEmptyMemberList(data.memberUids, 50) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
             (!('worldId' in data) || (data.worldId is string && data.worldId.size() <= 128)) &&
             data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 24 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTeamMembership(data) {
      return data.teamId is string && isValidId(data.teamId) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.role is string && data.role in ['owner', 'administrator', 'editor', 'viewer'] &&
             data.status is string && data.status in ['active', 'invited'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidActivity(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isNonEmptyMemberList(data.memberUids, 50) &&
             (!('worldId' in data) || (data.worldId is string && data.worldId.size() <= 128)) &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 160 &&
             data.category is string && data.category in ['world', 'project', 'task', 'agent', 'team', 'market'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidConversation(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             (!('worldId' in data) || (data.worldId is string && data.worldId.size() <= 128)) &&
             data.agentId is string && data.agentId in ['architect', 'researcher', 'developer', 'strategist', 'creator', 'council', 'voice'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 4000 &&
             data.responseSummary is string && data.responseSummary.size() <= 12000 &&
             data.isVoice is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAgentRun(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             (!('worldId' in data) || (data.worldId is string && data.worldId.size() <= 128)) &&
             data.taskPrompt is string && data.taskPrompt.size() >= 1 && data.taskPrompt.size() <= 4000 &&
             isNonEmptyMemberList(data.selectedAgents, 5) &&
             data.agentOutputs is map &&
             data.consolidatedResult is string && data.consolidatedResult.size() <= 12000 &&
             data.status is string && data.status in ['running', 'completed', 'failed'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMarketplaceItem(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
             data.category is string && data.category in ['Architecture', 'AI Prompt', 'World Kit', 'UI System', 'Workflow'] &&
             data.coverKey is string && data.coverKey in ['architect', 'neural', 'cosmos', 'universe'] &&
             (!('tags' in data) || isStringList(data.tags, 8)) &&
             (!('favoriteUids' in data) || isStringList(data.favoriteUids, 500)) &&
             data.isPublic is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNotificationItem(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
             data.category is string && data.category in ['system', 'agent', 'team', 'world'] &&
             data.isRead is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles (strictly owner-only PII isolation)
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'roleTitle', 'bio', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'roleTitle', 'bio', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Digital Worlds
    match /worlds/{worldId} {
      allow get: if isSignedIn() && isValidId(worldId) && hasMemberAccess(existing());
      allow list: if isSignedIn() && hasMemberAccess(existing());
      allow create: if isSignedIn() &&
                       isValidId(worldId) &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().keys().hasAll(['ownerId', 'memberUids', 'name', 'colorHex', 'category', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'memberUids', 'name', 'description', 'colorHex', 'category', 'connectedWorldIds', 'orbitRadius', 'orbitAngle', 'planetScale', 'createdAt', 'updatedAt']) &&
                       isValidWorld(incoming());
      allow update: if isSignedIn() &&
                       isValidId(worldId) &&
                       isValidWorld(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'name', 'description', 'colorHex', 'category', 'connectedWorldIds', 'orbitRadius', 'orbitAngle', 'planetScale', 'updatedAt'])) ||
                         ((request.auth.uid in existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'colorHex', 'category', 'connectedWorldIds', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(worldId) && existing().ownerId == request.auth.uid;
    }

    // 3. Projects (Parent-gated to existing World on create, terminal lock on archived unless owner)
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && hasMemberAccess(existing());
      allow list: if isSignedIn() && hasMemberAccess(existing());
      allow create: if isSignedIn() &&
                       isValidId(projectId) &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().keys().hasAll(['ownerId', 'memberUids', 'worldId', 'title', 'status', 'progress', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'memberUids', 'worldId', 'title', 'summary', 'status', 'progress', 'createdAt', 'updatedAt']) &&
                       isValidProject(incoming()) &&
                       exists(/databases/$(database)/documents/worlds/$(incoming().worldId));
      allow update: if isSignedIn() &&
                       isValidId(projectId) &&
                       isValidProject(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().worldId == existing().worldId &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().status != 'archived' || existing().ownerId == request.auth.uid) &&
                       hasMemberAccess(existing()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'status', 'progress', 'memberUids', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }

    // 4. Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && hasMemberAccess(existing());
      allow list: if isSignedIn() && hasMemberAccess(existing());
      allow create: if isSignedIn() &&
                       isValidId(taskId) &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().keys().hasAll(['ownerId', 'memberUids', 'worldId', 'title', 'status', 'priority', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'memberUids', 'worldId', 'projectId', 'title', 'description', 'status', 'priority', 'assignedAgent', 'createdAt', 'updatedAt']) &&
                       isValidTaskItem(incoming()) &&
                       exists(/databases/$(database)/documents/worlds/$(incoming().worldId));
      allow update: if isSignedIn() &&
                       isValidId(taskId) &&
                       isValidTaskItem(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().worldId == existing().worldId &&
                       incoming().createdAt == existing().createdAt &&
                       hasMemberAccess(existing()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'priority', 'assignedAgent', 'projectId', 'memberUids', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(taskId) && existing().ownerId == request.auth.uid;
    }

    // 5. Teams
    match /teams/{teamId} {
      allow get: if isSignedIn() && isValidId(teamId) && hasMemberAccess(existing());
      allow list: if isSignedIn() && hasMemberAccess(existing());
      allow create: if isSignedIn() &&
                       isValidId(teamId) &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().keys().hasAll(['ownerId', 'memberUids', 'name', 'inviteCode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'memberUids', 'name', 'description', 'worldId', 'inviteCode', 'createdAt', 'updatedAt']) &&
                       isValidTeam(incoming());
      allow update: if isSignedIn() &&
                       isValidId(teamId) &&
                       isValidTeam(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().ownerId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'worldId', 'memberUids', 'inviteCode', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(teamId) && existing().ownerId == request.auth.uid;
    }

    // 6. Team Memberships (Role-Based Access)
    match /team_memberships/{membershipId} {
      allow get: if isSignedIn() && isValidId(membershipId) && (existing().ownerId == request.auth.uid || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || existing().userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(membershipId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['teamId', 'ownerId', 'userId', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['teamId', 'ownerId', 'userId', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
                       isValidTeamMembership(incoming()) &&
                       exists(/databases/$(database)/documents/teams/$(incoming().teamId)) &&
                       get(/databases/$(database)/documents/teams/$(incoming().teamId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
                       isValidId(membershipId) &&
                       isValidTeamMembership(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().teamId == existing().teamId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().ownerId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(membershipId) && (existing().ownerId == request.auth.uid || existing().userId == request.auth.uid);
    }

    // 7. Activities (Append-only feed)
    match /activities/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) && hasMemberAccess(existing());
      allow list: if isSignedIn() && hasMemberAccess(existing());
      allow create: if isSignedIn() &&
                       isValidId(activityId) &&
                       incoming().ownerId == request.auth.uid &&
                       (request.auth.uid in incoming().memberUids) &&
                       incoming().keys().hasAll(['ownerId', 'memberUids', 'actorName', 'action', 'category', 'createdAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'memberUids', 'worldId', 'actorName', 'action', 'category', 'createdAt']) &&
                       isValidActivity(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(activityId) && existing().ownerId == request.auth.uid;
    }

    // 8. Conversations (Owner-only AI & Voice history)
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'agentId', 'title', 'prompt', 'responseSummary', 'isVoice', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'worldId', 'agentId', 'title', 'prompt', 'responseSummary', 'isVoice', 'createdAt', 'updatedAt']) &&
                       isValidConversation(incoming());
      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'responseSummary', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(conversationId) && existing().ownerId == request.auth.uid;
    }

    // 9. Multi-Agent Runs (Owner-only)
    match /agent_runs/{runId} {
      allow get: if isSignedIn() && isValidId(runId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(runId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'taskPrompt', 'selectedAgents', 'agentOutputs', 'consolidatedResult', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'worldId', 'taskPrompt', 'selectedAgents', 'agentOutputs', 'consolidatedResult', 'status', 'createdAt', 'updatedAt']) &&
                       isValidAgentRun(incoming());
      allow update: if isSignedIn() &&
                       isValidId(runId) &&
                       isValidAgentRun(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status == 'running' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['agentOutputs', 'consolidatedResult', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(runId) && existing().ownerId == request.auth.uid;
    }

    // 10. Nexus Market Items
    match /marketplace_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (existing().isPublic == true || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && (existing().isPublic == true || existing().ownerId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'creatorName', 'title', 'description', 'category', 'coverKey', 'isPublic', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'creatorName', 'title', 'description', 'category', 'coverKey', 'tags', 'favoriteUids', 'isPublic', 'createdAt', 'updatedAt']) &&
                       isValidMarketplaceItem(incoming());
      allow update: if isSignedIn() &&
                       isValidId(itemId) &&
                       isValidMarketplaceItem(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'coverKey', 'tags', 'favoriteUids', 'isPublic', 'updatedAt'])) ||
                         (existing().isPublic == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['favoriteUids', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
    }

    // 11. Notifications (Owner-only)
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['ownerId', 'title', 'message', 'category', 'isRead', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'title', 'message', 'category', 'isRead', 'createdAt', 'updatedAt']) &&
                       isValidNotificationItem(incoming());
      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidNotificationItem(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(notificationId) && existing().ownerId == request.auth.uid;
    }
  }
}
